# Copier en .env et remplir
DATABASE_URL=postgresql://user:password@localhost:5432/sublime
# Clé 32 octets hex (openssl rand -hex 32) : chiffre les clés API SpicyAPI en base
APP_SECRET=
API_PORT=3470
CLIENT_URL=http://localhost:3070
# Dossier local : médias générés et références
DATA_DIR=~/Documents/ai-influence-app
# Optionnel, utilisé uniquement par le serveur MCP SpicyAPI (.mcp.json)
spicyApiKey=
# Optionnel : ComfyUI local. Vide = fonctionnalité masquée dans l'app.
# COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_URL=
# Démarrage / arrêt depuis l'app (les deux sont nécessaires). Le démarrage doit rendre la main (--background).
# COMFYUI_LAUNCH=python -m comfy_cli launch --background
# COMFYUI_STOP=python -m comfy_cli stop --port 8188
COMFYUI_LAUNCH=
COMFYUI_STOP=
# Dossier de ComfyUI (ex. A:\ComfyUI) : l'app y supprime sa copie de chaque image une fois rapatriée. Vide = rien n'est supprimé.
COMFYUI_DIR=

# Optionnel : serveur de voix local (Chatterbox, cf. voice-server/). Vide = voix des personnages masquée.
# VOICE_URL=http://127.0.0.1:8190
# VOICE_LAUNCH=chemin/vers/.venv/Scripts/python.exe voice-server/server.py --port 8190 --models chemin/vers/cache-hf
VOICE_URL=
VOICE_LAUNCH=

# Optionnel : LLM local (Ollama) pour reformuler les prompts dictés. Vide = bouton « Reformuler » masqué.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=   (nom de `ollama list` ; vide = le premier installé)
OLLAMA_URL=
OLLAMA_MODEL=

# Optionnel : bibliothèque LoRA Civitai (https://civitai.com/user/account → API Keys)
CIVITAI_KEY=

# Optionnel : photos libres de droits Unsplash dans le bouton + (https://unsplash.com/oauth/applications → Access Key)
UNSPLASH_ACCESS_KEY=
# Optionnel : photos libres de droits Pexels dans le bouton + (https://www.pexels.com/api/ → Your API Key)
PEXELS_API_KEY=
