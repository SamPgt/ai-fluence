# Copier en .env et remplir
DATABASE_URL=postgresql://user:password@localhost:5432/ai-fluence
# Clé 32 octets hex (openssl rand -hex 32) : chiffre les clés API SpicyAPI en base
APP_SECRET=
API_PORT=3470
CLIENT_URL=http://localhost:3070
# Dossier local : médias générés et références
DATA_DIR=~/Documents/ai-influence-app
# Optionnel, utilisé uniquement par le serveur MCP SpicyAPI (.mcp.json)
spicyApiKey=

# Optionnel : bibliothèque LoRA Civitai (https://civitai.com/user/account → API Keys)
CIVITAI_KEY=

# Optionnel : photos libres de droits Unsplash dans le bouton + (https://unsplash.com/oauth/applications → Access Key)
UNSPLASH_ACCESS_KEY=
# Optionnel : photos libres de droits Pexels dans le bouton + (https://www.pexels.com/api/ → Your API Key)
PEXELS_API_KEY=
