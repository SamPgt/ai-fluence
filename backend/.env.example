# Copier en .env et remplir
DATABASE_URL=postgresql://user:password@localhost:5432/ai-fluence
# Clé 32 octets hex (openssl rand -hex 32) : chiffre les clés API SpicyAPI en base
APP_SECRET=
API_PORT=3470
CLIENT_URL=http://localhost:3070
# Dossier local : médias générés et références
DATA_DIR=~/Documents/ai-influence-app
# Optionnel, utilisé uniquement par le serveur MCP SpicyAPI (.mcp.json)
spicyApiKey=
# Optionnel : ComfyUI local. Vide = fonctionnalité masquée dans l'app.
# COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_URL=
# Démarrage / arrêt depuis l'app (les deux sont nécessaires). Le démarrage doit rendre la main (--background).
# COMFYUI_LAUNCH=python -m comfy_cli launch --background
# COMFYUI_STOP=python -m comfy_cli stop --port 8188
COMFYUI_LAUNCH=
COMFYUI_STOP=
# Dossier de ComfyUI (ex. A:\ComfyUI) : l'app y supprime sa copie de chaque image une fois rapatriée. Vide = rien n'est supprimé.
COMFYUI_DIR=
